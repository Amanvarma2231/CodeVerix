# Copy this file to .env and configure your preferred provider

# LLM Provider selection:
#   "free"   -> 100% Free AI (no API key required!)
#   "gemini" -> Google Gemini (requires GEMINI_API_KEY)
#   "openai" -> OpenAI (requires OPENAI_API_KEY)
LLM_PROVIDER=free

# Model names
# For free: openai, qwen-coder, mistral, llama
# For gemini: gemini-3.8-flash, gemini-flash-latest, gemma-4-31b-it
CODER_MODEL=openai
VALIDATOR_MODEL=openai

# Google Gemini API Key (optional, get from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (optional, for GPT models)
OPENAI_API_KEY=your_openai_api_key_here
